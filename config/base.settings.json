{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./.env.staging)",
      "Read(./.env.development)",
      "Read(./.env.test)",
      "Read(./.env.prod)",
      "Read(./**/.env.local)",
      "Read(./**/.env.production)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": ".claude/hooks/destructive-commands.sh" } ] },
      { "matcher": "Read|Grep|Edit|Write|Bash", "hooks": [ { "type": "command", "command": ".claude/hooks/protect-env-files.sh" } ] },
      { "matcher": "Edit|Write|Bash", "hooks": [ { "type": "command", "command": ".claude/hooks/protect-sensitive.sh" } ] },
      { "matcher": "Edit|Write", "hooks": [ { "type": "command", "command": ".claude/hooks/protect-applied-migrations.sh" } ] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write", "hooks": [ { "type": "command", "command": ".claude/hooks/auto-format.sh" } ] },
      { "matcher": "Edit|Write", "hooks": [ { "type": "command", "command": ".claude/hooks/test-reminder.sh" } ] }
    ],
    "UserPromptSubmit": [
      { "matcher": "", "hooks": [ { "type": "command", "command": ".claude/hooks/detect-secrets.sh" } ] },
      { "matcher": "", "hooks": [ { "type": "command", "command": ".claude/hooks/issue-creation-nudge.sh" } ] }
    ]
  }
}
